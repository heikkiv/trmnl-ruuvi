"""
Configuration file for local development with measurement_updater.py.
Copy this file to config.py and fill in your credentials.

For the Lambda function (lambda_function.py), set these as Lambda
environment variables instead:

  RUUVI_TOKEN     - Ruuvi Network API bearer token
  TRMNL_URL       - TRMNL custom plugin webhook URL
  RUUVI_API_URL   - (optional) Override Ruuvi API URL
  PLUGIN_NAME     - (optional) Plugin title shown in the title bar, default "Ruuvi"
"""

# TRMNL API endpoint
trmnl_url = 'https://usetrmnl.com/api/custom_plugins/your-plugin-id'

# Ruuvi Network API configuration
ruuvi_token = 'your-ruuvi-token'
ruuvi_api_url = 'https://network.ruuvi.com/sensors-dense?sharedToMe=true&measurements=true&alerts=true&sharedToOthers=true'

# Update interval in seconds (default: 15 minutes)
update_interval = 60 * 15

# Retry interval in seconds when an exception occurs
retry_interval = 60
